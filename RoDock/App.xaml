<Application x:Class="RoDock.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RoDock"
             StartupUri="MainWindow.xaml"
             ThemeMode="Dark">
    <Application.Resources>
        <!-- Palette. These are only the starting values: Themes.Apply replaces them from the chosen theme (5 base colours, the rest derived). -->
        <SolidColorBrush x:Key="TextSoft" Color="#29E8EEF7" />
        <SolidColorBrush x:Key="TextEdge" Color="#59E8EEF7" />
        <SolidColorBrush x:Key="TextFaint" Color="#1AE8EEF7" />
        <SolidColorBrush x:Key="Line" Color="#14E8EEF7" />
        <SolidColorBrush x:Key="AccentSoft" Color="#2E7DB2F2" />
        <SolidColorBrush x:Key="AccentFill" Color="#337DB2F2" />
        <SolidColorBrush x:Key="DeepDim" Color="#A60A0E15" />
        <SolidColorBrush x:Key="DeepOverlay" Color="#F20A0E15" />
        <SolidColorBrush x:Key="Bg" Color="#0E131C" />
        <SolidColorBrush x:Key="Card" Color="#141B26" />
        <SolidColorBrush x:Key="Deep" Color="#0A0E15" />
        <SolidColorBrush x:Key="Raised" Color="#1C2533" />
        <SolidColorBrush x:Key="Neutral" Color="#3A465A" />
        <SolidColorBrush x:Key="CardHi" Color="#243044" />
        <SolidColorBrush x:Key="Scrim" Color="#D10A0E15" />
        <SolidColorBrush x:Key="Text" Color="#E8EEF7" />
        <SolidColorBrush x:Key="Muted" Color="#A3AEC2" />
        <SolidColorBrush x:Key="Accent" Color="#7DB2F2" />
        <SolidColorBrush x:Key="Ink" Color="#0B1220" />
        <SolidColorBrush x:Key="Idle" Color="#8794AB" />
        <SolidColorBrush x:Key="Good" Color="#4CC38A" />
        <SolidColorBrush x:Key="Warn" Color="#E0A93B" />
        <SolidColorBrush x:Key="Bad" Color="#E5484D" />

<BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- Icons (24x24 grid) -->
        <StreamGeometry x:Key="IconPlay">M7,4.5 L7,19.5 L20,12 Z</StreamGeometry>
        <StreamGeometry x:Key="IconStop">M6,6 L18,6 L18,18 L6,18 Z</StreamGeometry>
        <StreamGeometry x:Key="IconPlus">M12,5 L12,19 M5,12 L19,12</StreamGeometry>
        <StreamGeometry x:Key="IconGrid">M4,4 L11,4 L11,11 L4,11 Z M13,4 L20,4 L20,11 L13,11 Z M4,13 L11,13 L11,20 L4,20 Z M13,13 L20,13 L20,20 L13,20 Z</StreamGeometry>
        <StreamGeometry x:Key="IconList">M4,7 L20,7 M4,12 L20,12 M4,17 L20,17</StreamGeometry>
        <StreamGeometry x:Key="IconRefresh">M20,11 A8,8 0 1 0 17.7,16.7 M20,4 L20,11 L13,11</StreamGeometry>
        <StreamGeometry x:Key="IconChat">M21,12 A8,8 0 0 1 9.4,19.1 L4,20.5 L5.5,15.9 A8,8 0 1 1 21,12 Z</StreamGeometry>
        <StreamGeometry x:Key="IconSliders">M4,7 L14,7 M18,7 L20,7 M4,17 L6,17 M10,17 L20,17 M14,7 A2,2 0 1 0 18,7 A2,2 0 1 0 14,7 M6,17 A2,2 0 1 0 10,17 A2,2 0 1 0 6,17</StreamGeometry>
        <StreamGeometry x:Key="IconLock">M5,11 L19,11 L19,20 L5,20 Z M8,11 L8,8 A4,4 0 0 1 16,8 L16,11</StreamGeometry>
        <StreamGeometry x:Key="IconLogo">M8,17 L8,6 L12.5,6 A2.75,2.75 0 0 1 12.5,11.5 L8,11.5 M12,11.5 L15.5,17 M7,20.5 L17,20.5</StreamGeometry>
        <StreamGeometry x:Key="IconLogin">M15,3 L19,3 A2,2 0 0 1 21,5 L21,19 A2,2 0 0 1 19,21 L15,21 M10,17 L15,12 L10,7 M15,12 L3,12</StreamGeometry>
        <StreamGeometry x:Key="IconUser">M8,8 A4,4 0 1 0 16,8 A4,4 0 1 0 8,8 M4,21 A8,8 0 0 1 20,21</StreamGeometry>
        <StreamGeometry x:Key="IconPalette">M12,3 A9,9 0 1 0 12,21 C13.6,21 14.2,19.8 13.6,18.6 C13,17.4 13.7,16.5 15,16.5 L17,16.5 A4,4 0 0 0 21,12.5 C21,7.5 17,3 12,3 Z M7.5,11 L7.6,11 M10,7.5 L10.1,7.5 M14.5,7.5 L14.6,7.5</StreamGeometry>
        <StreamGeometry x:Key="IconPin">M12,21 C12,21 19,15 19,9.5 A7,7 0 0 0 5,9.5 C5,15 12,21 12,21 Z M9.5,9.5 A2.5,2.5 0 1 0 14.5,9.5 A2.5,2.5 0 1 0 9.5,9.5</StreamGeometry>

        <!-- Icons take their colour from the button they sit in -->
        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>
        <Style x:Key="IconFill" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
        </Style>
        <!-- Play triangle, or stop square while Account.Running -->
        <Style x:Key="RunGlyph" TargetType="Path" BasedOn="{StaticResource IconFill}">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Data" Value="{StaticResource IconPlay}" />
            <Setter Property="local:Animations.Fade" Value="{Binding Running}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Running}" Value="True"><Setter Property="Data" Value="{StaticResource IconStop}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource Idle}" />
            <Setter Property="local:Animations.Pulse" Value="{Binding StatusKind}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="Working"><Setter Property="Fill" Value="{StaticResource Warn}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Good"><Setter Property="Fill" Value="{StaticResource Good}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Warn"><Setter Property="Fill" Value="{StaticResource Bad}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Bad"><Setter Property="Fill" Value="{StaticResource Bad}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Buttons: raised surface with a hairline, 10 px corners. Primary is the one bright button on a screen. -->
        <ControlTemplate x:Key="PillTemplate" TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="Button">
            <Setter Property="Template" Value="{StaticResource PillTemplate}" />
            <Setter Property="Background" Value="{DynamicResource Raised}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Text}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}" />

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <!-- Start/Stop button: text follows Account.Running -->
        <Style x:Key="RunButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="Start" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Running}" Value="True"><Setter Property="Content" Value="Stop" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Small play/stop button on a dock tile -->
        <Style x:Key="TileRun" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="{DynamicResource Scrim}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource CardHi}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin bar for the ranked list -->
        <Style x:Key="ThinBar" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Height" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="2" Background="{DynamicResource Raised}" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


<!-- Rails: 40 px square buttons; the active one is a raised surface with a hairline -->
        <Style x:Key="RailRadio" TargetType="RadioButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource Idle}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="10" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Raised}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Line}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RailToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource Idle}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="10" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Raised}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Line}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddRail" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="{DynamicResource Idle}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle RadiusX="10" RadiusY="10" Stroke="{DynamicResource TextEdge}" StrokeThickness="1" StrokeDashArray="3 3" />
                            <Path x:Name="plus" Data="{StaticResource IconPlus}" Width="16" Height="16" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="plus" Property="Stroke" Value="{DynamicResource Text}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RailSoft" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="{DynamicResource Idle}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Card}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


<!-- Window buttons in the custom title bar; Tag is the colour shown on hover -->
        <SolidColorBrush x:Key="CloseHover" Color="#E81123" />
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Tag" Value="{DynamicResource TextFaint}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Tag" Value="{StaticResource CloseHover}" />
        </Style>

        <Style x:Key="GearToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg" CornerRadius="8" Background="{DynamicResource Scrim}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.85" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkbox drawn as an on/off switch -->
        <Style x:Key="SwitchBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="22" Background="Transparent">
                            <Border x:Name="track" CornerRadius="11" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="1" />
                            <!-- slide and stretch are driven by Animations.Thumb; the Setters below still decide the resting side -->
                            <Ellipse x:Name="thumb" Width="16" Height="16" HorizontalAlignment="Left" Margin="3,0,0,0" Fill="{DynamicResource Text}" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="stretch" />
                                        <TranslateTransform x:Name="slide" />
                                    </TransformGroup>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0" />
                                <Setter TargetName="thumb" Property="Fill" Value="{DynamicResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

</Application.Resources>
</Application>
