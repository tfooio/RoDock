<Application x:Class="RoDock.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ThemeMode="Dark">
    <Application.Resources>
        <!-- Palette: change these to restyle the whole app -->
        <SolidColorBrush x:Key="Bg" Color="#0F1117" />
        <SolidColorBrush x:Key="Card" Color="#181B24" />
        <SolidColorBrush x:Key="CardHi" Color="#232838" />
        <SolidColorBrush x:Key="Text" Color="#E8EAF0" />
        <SolidColorBrush x:Key="Muted" Color="#8A90A2" />
        <SolidColorBrush x:Key="Accent" Color="#6C7BFF" />
        <SolidColorBrush x:Key="Good" Color="#3DD68C" />
        <SolidColorBrush x:Key="Warn" Color="#F5B94A" />
        <SolidColorBrush x:Key="Bad" Color="#FF6B6B" />

        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="Working"><Setter Property="Fill" Value="{StaticResource Accent}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Good"><Setter Property="Fill" Value="{StaticResource Good}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Warn"><Setter Property="Fill" Value="{StaticResource Warn}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Bad"><Setter Property="Fill" Value="{StaticResource Bad}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="16,6" />
        </Style>

        <!-- Start/Stop button: text and colour follow Account.Running -->
        <Style x:Key="RunButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Content" Value="Start" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Running}" Value="True">
                    <Setter Property="Content" Value="Stop" />
                    <Setter Property="Background" Value="{StaticResource CardHi}" />
                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
