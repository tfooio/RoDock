<UserControl x:Class="RoDock.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="240">
    <StackPanel>
        <!-- Saturation (left to right) and brightness (bottom to top) of the chosen hue -->
        <Grid x:Name="Sv" Width="240" Height="150" Cursor="Cross" Background="Transparent"
              MouseLeftButtonDown="Sv_Down" MouseMove="Sv_Move" MouseLeftButtonUp="Release">
            <Rectangle x:Name="SvHue" RadiusX="10" RadiusY="10" />
            <Rectangle RadiusX="10" RadiusY="10">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle RadiusX="10" RadiusY="10">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="SvThumb" Width="18" Height="18" Stroke="White" StrokeThickness="2.5" />
            </Canvas>
        </Grid>

        <Grid x:Name="HueBar" Width="240" Height="18" Margin="0,12,0,0" Cursor="Hand" Background="Transparent"
              MouseLeftButtonDown="Hue_Down" MouseMove="Hue_Move" MouseLeftButtonUp="Release">
            <Rectangle RadiusX="9" RadiusY="9">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF0000" Offset="0" />
                        <GradientStop Color="#FFFF00" Offset="0.1667" />
                        <GradientStop Color="#00FF00" Offset="0.3333" />
                        <GradientStop Color="#00FFFF" Offset="0.5" />
                        <GradientStop Color="#0000FF" Offset="0.6667" />
                        <GradientStop Color="#FF00FF" Offset="0.8333" />
                        <GradientStop Color="#FF0000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="HueThumb" Width="18" Height="18" Stroke="White" StrokeThickness="2.5" />
            </Canvas>
        </Grid>

        <TextBox x:Name="HexBox" Margin="0,12,0,0" Height="36" MaxLength="9" VerticalContentAlignment="Center" LostFocus="Hex_Commit" KeyDown="Hex_KeyDown" />
    </StackPanel>
</UserControl>
